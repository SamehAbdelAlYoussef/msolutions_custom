<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Daily reminder: notify each manager about their salespersons'
             overdue activities in Sales Visit Plans. -->
        <record id="cron_notify_overdue_activities" model="ir.cron">
            <field name="name">Sales Visit Plan: Overdue Activities Reminder</field>
            <field name="model_id" ref="model_sales_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_overdue_activities()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
