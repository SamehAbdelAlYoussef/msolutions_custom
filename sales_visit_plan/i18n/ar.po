#. module: sales_visit_plan
#: model:mail.template,body_html:sales_visit_plan.email_template_approval_confirmation
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"\n"
"    <h2 style=\"color: #28a745;\">✓ Plan Approved</h2>\n"
"\n"
"    <p>Dear <t t-out=\"object.user_id.name\"/>,</p>\n"
"\n"
"    <p>Your visit plan <strong><t t-out=\"object.name\"/></strong> has been approved!</p>\n"
"\n"
"    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n"
"        <tr style=\"background-color: #f9f9f9;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Plan Name</td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><t t-out=\"object.name\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Region</td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><t t-out=\"object.region\"/></td>\n"
"        </tr>\n"
"        <tr style=\"background-color: #f9f9f9;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Date Range</td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">\n"
"                <t t-out=\"object.date_start\"/> → <t t-out=\"object.date_end\"/>\n"
"            </td>\n"
"        </tr>\n"
"    </table>\n"
"\n"
"    <p>You can now start executing your visits as scheduled.</p>\n"
"\n"
"    <p>\n"
"        <a t-att-href=\"'/web#id=%s&amp;model=sales.plan&amp;view_type=form' % object.id\" style=\"display: inline-block; padding: 10px 20px; background-color: #28a745; color: #ffffff;                   text-decoration: none; border-radius: 4px; font-weight: bold;\">\n"
"            View Plan\n"
"        </a>\n"
"    </p>\n"
"\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        This is an automated message from the Sales Visit Plan system.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: sales_visit_plan
#: model:mail.template,body_html:sales_visit_plan.email_template_approval_request
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"\n"
"    <h2 style=\"color: #714B67;\">Plan Approval Request</h2>\n"
"\n"
"    <p>Dear Manager,</p>\n"
"\n"
"    <p>A new visit plan requires your review and approval.</p>\n"
"\n"
"    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n"
"        <tr style=\"background-color: #f9f9f9;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Plan Name</td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><t t-out=\"object.name\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Salesperson</td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><t t-out=\"object.user_id.name\"/></td>\n"
"        </tr>\n"
"        <tr style=\"background-color: #f9f9f9;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Region</td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><t t-out=\"object.region\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Date Range</td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">\n"
"                <t t-out=\"object.date_start\"/> → <t t-out=\"object.date_end\"/>\n"
"                (<t t-out=\"object.duration_days\"/> days)\n"
"            </td>\n"
"        </tr>\n"
"        <tr style=\"background-color: #f9f9f9;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Visits</td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><t t-out=\"object.visit_count\"/> visit(s)</td>\n"
"        </tr>\n"
"    </table>\n"
"\n"
"    <p>Please review this plan and approve it through the system.</p>\n"
"\n"
"    <p>\n"
"        <a t-att-href=\"'/web#id=%s&amp;model=sales.plan&amp;view_type=form' % object.id\" style=\"display: inline-block; padding: 10px 20px; background-color: #714B67; color: #ffffff;                   text-decoration: none; border-radius: 4px; font-weight: bold;\">\n"
"            Open Plan\n"
"        </a>\n"
"    </p>\n"
"\n"
"    <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"        This is an automated message from the Sales Visit Plan system.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

