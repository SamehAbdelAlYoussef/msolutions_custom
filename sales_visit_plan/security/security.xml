<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sales Manager group for visit plan approvals -->
        <record id="group_sales_manager" model="res.groups">
            <field name="name">Manager (Sales Visit Plan)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users in this group can approve sales visit plans.</field>
        </record>

    </data>

    <!-- Record Rules (noupdate=0 so they are created on upgrade) -->
    <data noupdate="0">

        <!-- === sales.plan rules === -->

        <!-- Salespersons see only their own plans -->
        <record id="ir_rule_sales_plan_salesperson" model="ir.rule">
            <field name="name">Salesperson: own plans only</field>
            <field name="model_id" ref="model_sales_plan"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Managers oversee the whole team: full access to all plans -->
        <record id="ir_rule_sales_plan_manager" model="ir.rule">
            <field name="name">Manager: all plans</field>
            <field name="model_id" ref="model_sales_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
        </record>

        <!-- === sales.plan.line rules === -->

        <!-- Salespersons see only lines of their own plans -->
        <record id="ir_rule_sales_plan_line_salesperson" model="ir.rule">
            <field name="name">Salesperson: own plan lines only</field>
            <field name="model_id" ref="model_sales_plan_line"/>
            <field name="domain_force">[('plan_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Managers oversee the whole team: full access to all visit lines -->
        <record id="ir_rule_sales_plan_line_manager" model="ir.rule">
            <field name="name">Manager: all plan lines</field>
            <field name="model_id" ref="model_sales_plan_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
        </record>

        <!-- === sales.requisition rules === -->

        <!-- Users see requisitions they created OR are an approver on -->
        <record id="ir_rule_requisition_user" model="ir.rule">
            <field name="name">Requisition: own or awaiting my approval</field>
            <field name="model_id" ref="model_sales_requisition"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('approval_line_ids.approver_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="ir_rule_requisition_manager" model="ir.rule">
            <field name="name">Requisition: manager sees all</field>
            <field name="model_id" ref="model_sales_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
        </record>

        <!-- === sales.requisition.approval rules === -->
        <record id="ir_rule_requisition_approval_user" model="ir.rule">
            <field name="name">Approval step: own requisition or my step</field>
            <field name="model_id" ref="model_sales_requisition_approval"/>
            <field name="domain_force">['|', ('requisition_id.user_id', '=', user.id), ('approver_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="ir_rule_requisition_approval_manager" model="ir.rule">
            <field name="name">Approval step: manager sees all</field>
            <field name="model_id" ref="model_sales_requisition_approval"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
        </record>

        <!-- === sales.requisition.line rules === -->
        <record id="ir_rule_requisition_line_user" model="ir.rule">
            <field name="name">Requisition line: own or awaiting my approval</field>
            <field name="model_id" ref="model_sales_requisition_line"/>
            <field name="domain_force">['|', ('requisition_id.user_id', '=', user.id), ('requisition_id.approval_line_ids.approver_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="ir_rule_requisition_line_manager" model="ir.rule">
            <field name="name">Requisition line: manager sees all</field>
            <field name="model_id" ref="model_sales_requisition_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
        </record>

    </data>
</odoo>
