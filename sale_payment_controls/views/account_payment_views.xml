<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_receipt" model="ir.ui.view">
        <field name="name">account.payment.form.receipt.number</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_id']" position="after">
                <field name="receipt_number"
                       invisible="not sale_order_id or payment_type != 'inbound'"
                       readonly="state not in ('draft', False)"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_list_receipt" model="ir.ui.view">
        <field name="name">account.payment.list.receipt.number</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_company_currency_signed']" position="before">
                <field name="receipt_number" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_receipt" model="ir.ui.view">
        <field name="name">account.payment.search.receipt.number</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="receipt_number"/>
            </xpath>
        </field>
    </record>
</odoo>
