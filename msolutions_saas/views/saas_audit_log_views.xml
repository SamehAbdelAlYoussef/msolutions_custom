<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_saas_audit_log_list" model="ir.ui.view">
        <field name="name">saas.audit.log.list</field>
        <field name="model">saas.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="false" edit="false" delete="false"
                  default_order="create_date desc">
                <field name="create_date" string="When"/>
                <field name="user_id" string="Who"/>
                <field name="tenant_name" string="Tenant"/>
                <field name="action" widget="badge"
                       decoration-success="action in ('provision_ok', 'drop_ok')"
                       decoration-danger="action in ('provision_failed', 'drop_failed')"
                       decoration-info="action in ('provision_queued', 'drop_queued', 'retry_queued')"/>
                <field name="detail" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_saas_audit_log_search" model="ir.ui.view">
        <field name="name">saas.audit.log.search</field>
        <field name="model">saas.audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Log">

                <field name="tenant_name" string="Tenant"/>
                <field name="user_id" string="User"/>
                <field name="detail" string="Detail"/>

                <filter name="filter_success" string="Succeeded"
                        domain="[('action', 'in', ['provision_ok', 'drop_ok'])]"/>
                <filter name="filter_failed" string="Failed"
                        domain="[('action', 'in', ['provision_failed', 'drop_failed'])]"/>
                <filter name="filter_queued" string="Queued"
                        domain="[('action', 'in', ['provision_queued', 'drop_queued', 'retry_queued'])]"/>

                <separator/>

                <filter name="filter_provision" string="Provisioning"
                        domain="[('action', 'in', ['provision_queued', 'provision_ok', 'provision_failed'])]"/>
                <filter name="filter_drop" string="Drops"
                        domain="[('action', 'in', ['drop_queued', 'drop_ok', 'drop_failed'])]"/>
                <filter name="filter_retry" string="Retries"
                        domain="[('action', '=', 'retry_queued')]"/>
                <filter name="filter_shell" string="Shell Queries"
                        domain="[('action', '=', 'shell_query')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_tenant" string="Tenant"
                            context="{'group_by': 'tenant_name'}"/>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_action" string="Action"
                            context="{'group_by': 'action'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'create_date:day'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_saas_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">saas.audit.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_saas_audit_log_search"/>
    </record>

    <menuitem id="menu_saas_audit_log" name="Audit Log" sequence="30"
              parent="msolutions_saas.menu_saas_root"
              action="action_saas_audit_log"
              groups="msolutions_saas.group_saas_developer"/>

</odoo>
