<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_restore_job_list" model="ir.ui.view">
        <field name="name">saas.restore.job.list</field>
        <field name="model">saas.restore.job</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="requested_at desc">
                <field name="requested_at"/>
                <field name="requested_by"/>
                <field name="tenant_name"/>
                <field name="dry_run" widget="boolean_toggle" string="Dry run"/>
                <field name="backup_date" string="Backup"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('done','dry_done')"
                       decoration-danger="state in ('failed','needs_reconcile')"
                       decoration-info="state in ('swapping','finalizing','maintenance','building')"
                       decoration-warning="state in ('queued','safety_backup','assembling','verifying')"/>
                <field name="old_retained" string="Old kept" optional="show"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_saas_restore_job_form" model="ir.ui.view">
        <field name="name">saas.restore.job.form</field>
        <field name="model">saas.restore.job</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="tenant_name"/>
                            <field name="dry_run"/>
                            <field name="backup_ref"/>
                            <field name="backup_date"/>
                            <field name="requested_by"/>
                            <field name="requested_at"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="finished_at"/>
                            <field name="scratch_db"/>
                            <field name="old_db"/>
                            <field name="old_retained"/>
                            <field name="safety_backup_ref"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                    <group string="Result / report">
                        <field name="message" nolabel="1"/>
                        <field name="report" nolabel="1" widget="text"/>
                    </group>
                    <group string="Swap journal (for reconcile)">
                        <field name="live_db_renamed"/>
                        <field name="scratch_db_renamed"/>
                        <field name="live_fs_renamed"/>
                        <field name="scratch_fs_renamed"/>
                        <field name="maintenance_on"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_saas_restore_job" model="ir.actions.act_window">
        <field name="name">Restore Jobs</field>
        <field name="res_model">saas.restore.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_saas_restore_jobs" name="Restore Jobs" sequence="28"
              parent="menu_saas_root" action="action_saas_restore_job"/>
</odoo>
