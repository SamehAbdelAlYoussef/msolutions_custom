<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_saas_config_form" model="ir.ui.view">
        <field name="name">saas.config.form</field>
        <field name="model">saas.config</field>
        <field name="arch" type="xml">
            <form string="SaaS Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>Default Apps</h1>
                    </div>
                    <p class="text-muted mb-3">
                        Apps selected here are installed automatically in every
                        new tenant database. You can override the list per tenant
                        in the <strong>Apps</strong> tab before clicking Create.
                    </p>
                    <field name="default_module_ids"
                           widget="many2many_tags"
                           domain="[('application', '=', True)]"
                           options="{'no_create': True, 'no_quick_create': True}"
                           placeholder="Select apps…"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action: always opens the single config record, creating it
         on first call via _get(). Avoids hardcoding a res_id. -->
    <record id="action_saas_config" model="ir.actions.server">
        <field name="name">Configuration</field>
        <field name="model_id" ref="model_saas_config"/>
        <field name="state">code</field>
        <field name="code">
record = env['saas.config']._get()
action = record.get_formview_action()
        </field>
    </record>

    <menuitem id="menu_saas_config"
              name="Configuration"
              parent="menu_saas_root"
              action="action_saas_config"
              sequence="40"
              groups="msolutions_saas.group_saas_developer"/>

</odoo>
