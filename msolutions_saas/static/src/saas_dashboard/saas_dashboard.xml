<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="msolutions_saas.SaasDashboard">
        <div class="o_saas_dashboard o_action h-100 overflow-auto p-4">

            <!-- ── Header ───────────────────────────────────────── -->
            <div class="d-flex align-items-center mb-3">
                <h2 class="mb-0 me-auto">Tenants</h2>
                <button class="btn btn-primary" t-on-click="onNewTenant">
                    <i class="fa fa-plus me-1"/>New Tenant
                </button>
            </div>

            <!-- ── Toolbar: search + filters ────────────────────── -->
            <div class="o_saas_toolbar mb-4">

                <div class="o_saas_search_wrap position-relative">
                    <i class="fa fa-search o_saas_search_icon"/>
                    <input type="search"
                           class="o_saas_search form-control form-control-sm"
                           placeholder="Search by name or company…"
                           autocomplete="off"
                           t-att-value="state.query"
                           t-on-input="onSearch"/>
                </div>

                <div class="o_saas_toolbar_divider"/>

                <div class="o_saas_filter_pills">
                    <button class="o_saas_pill btn btn-sm"
                            t-att-class="state.filter === 'all' ? 'o_saas_pill_active' : 'o_saas_pill_idle'"
                            t-on-click="() => this.setFilter('all')">
                        All
                        <span class="o_saas_pill_count" t-esc="state.tenants.length"/>
                    </button>
                    <button class="o_saas_pill btn btn-sm"
                            t-att-class="state.filter === 'active' ? 'o_saas_pill_active' : 'o_saas_pill_idle'"
                            t-on-click="() => this.setFilter('active')">
                        <span class="o_saas_pill_dot o_saas_dot_active"/>
                        Active
                        <span class="o_saas_pill_count"
                              t-esc="state.tenants.filter(t => t.state === 'active').length"/>
                    </button>
                    <button class="o_saas_pill btn btn-sm"
                            t-att-class="state.filter === 'inactive' ? 'o_saas_pill_active' : 'o_saas_pill_idle'"
                            t-on-click="() => this.setFilter('inactive')">
                        <span class="o_saas_pill_dot o_saas_dot_inactive"/>
                        Not Active
                        <span class="o_saas_pill_count"
                              t-esc="state.tenants.filter(t => t.state !== 'active').length"/>
                    </button>
                </div>

                <span t-if="isFiltered" class="text-muted small ms-auto">
                    <t t-esc="visibleTenants.length"/> of <t t-esc="state.tenants.length"/>
                </span>
            </div>

            <!-- ── Loading ──────────────────────────────────────── -->
            <div t-if="state.loading" class="text-muted">Loading…</div>

            <!-- ── Empty: no tenants at all ─────────────────────── -->
            <div t-elif="!state.tenants.length"
                 class="o_saas_empty text-center py-5">
                <i class="fa fa-server fa-3x mb-3"/>
                <p>No tenants yet.</p>
            </div>

            <!-- ── Empty: filter has no results ─────────────────── -->
            <div t-elif="!visibleTenants.length"
                 class="o_saas_empty text-center py-5">
                <i class="fa fa-filter fa-3x mb-3"/>
                <p class="mb-2">No tenants match your search.</p>
                <button class="btn btn-sm btn-link p-0"
                        t-on-click="() => { this.state.query = ''; this.state.filter = 'all'; }">
                    Clear filters
                </button>
            </div>

            <!-- ── Cards grid ────────────────────────────────────── -->
            <div t-else="" class="row g-3">
                <div t-foreach="visibleTenants" t-as="tenant" t-key="tenant.id"
                     class="col-12 col-md-6 col-xl-4">

                    <div t-att-class="cardClass(tenant)">

                        <!-- Card body -->
                        <div class="o_saas_card_body">
                            <div class="d-flex align-items-start gap-2 mb-2">
                                <div class="me-auto overflow-hidden">
                                    <div class="o_saas_card_name" t-esc="tenant.name"/>
                                    <div t-if="tenant.company_name"
                                         class="o_saas_card_company"
                                         t-esc="tenant.company_name"/>
                                </div>
                                <span t-att-class="badgeClass(tenant)"
                                      t-esc="stateLabel(tenant)"/>
                            </div>

                            <a t-att-href="tenant.url" target="_blank"
                               class="o_saas_card_url" t-esc="tenant.url"/>

                            <!-- First-time credentials -->
                            <div t-if="tenant.state === 'active' and tenant.admin_password"
                                 class="o_saas_card_creds mt-2">
                                <div class="small mb-1">
                                    <strong>Login:</strong>
                                    <span class="ms-1" t-esc="tenant.admin_login"/>
                                </div>
                                <div class="small">
                                    <strong>Password:</strong>
                                    <code class="ms-1" t-esc="tenant.admin_password"/>
                                </div>
                                <div class="text-muted mt-1" style="font-size:0.7rem">
                                    Hand this over once, then change it.
                                </div>
                            </div>

                            <!-- Error message -->
                            <div t-if="tenant.state === 'error'"
                                 class="o_saas_card_error_msg mt-2">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                <span class="text-truncate d-inline-block" style="max-width:90%"
                                      t-att-title="tenant.error_message"
                                      t-esc="tenant.error_message"/>
                            </div>
                        </div>

                        <!-- Card footer -->
                        <div class="o_saas_card_footer">
                            <a t-if="tenant.state === 'active'"
                               class="btn btn-sm btn-secondary"
                               t-att-href="tenant.url" target="_blank">
                                <i class="fa fa-external-link me-1"/>Open
                            </a>
                            <button t-if="tenant.state === 'error'"
                                    class="btn btn-sm btn-secondary"
                                    t-on-click="() => this.onRetry(tenant)">
                                <i class="fa fa-refresh me-1"/>Retry
                            </button>
                            <button t-if="['active', 'error'].includes(tenant.state)"
                                    class="btn btn-sm btn-link text-danger ms-auto"
                                    t-on-click="() => this.onDrop(tenant)">Drop</button>
                        </div>

                    </div>
                </div>
            </div>

            <!-- ── Pending indicator ─────────────────────────────── -->
            <div t-if="hasPending" class="text-muted small mt-3">
                <i class="fa fa-circle-o-notch fa-spin me-1"/>
                Work in progress — this page refreshes itself.
            </div>

        </div>
    </t>

    <t t-name="msolutions_saas.NewTenantDialog">
        <Dialog title="'New Tenant'" size="'md'">
            <div class="mb-3">
                <label class="form-label" for="saas_tenant_name">Tenant name</label>
                <input id="saas_tenant_name" type="text" class="form-control"
                       placeholder="acme" autocomplete="off"
                       t-att-value="state.name" t-on-input="onNameInput"/>
                <div class="form-text">
                    Becomes the database name and the subdomain.
                    <span t-if="preview">→ <code t-esc="preview"/></span>
                </div>
                <div t-if="state.error" class="text-danger small mt-1"
                     t-esc="state.error"/>
            </div>
            <div class="mb-1">
                <label class="form-label" for="saas_company_name">Company (optional)</label>
                <input id="saas_company_name" type="text" class="form-control"
                       autocomplete="off" t-model="state.companyName"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm">Create</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
