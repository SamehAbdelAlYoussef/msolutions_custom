<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="msolutions_saas.SaasDashboard">
        <div class="o_saas_dashboard o_action h-100 overflow-auto p-4">

            <div class="d-flex align-items-center mb-4">
                <h2 class="mb-0 me-auto">Tenants</h2>
                <button class="btn btn-primary" t-on-click="onNewTenant">
                    <i class="fa fa-plus me-1"/>New Tenant
                </button>
            </div>

            <div t-if="state.loading" class="text-muted">Loading…</div>

            <div t-elif="!state.tenants.length"
                 class="o_saas_empty text-center text-muted py-5">
                <i class="fa fa-server fa-3x mb-3 d-block opacity-50"/>
                <p class="mb-0">No tenants yet.</p>
            </div>

            <div t-else="" class="row g-3">
                <div t-foreach="state.tenants" t-as="tenant" t-key="tenant.id"
                     class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-start">
                                <div class="me-auto">
                                    <h5 class="card-title mb-1" t-esc="tenant.name"/>
                                    <div t-if="tenant.company_name"
                                         class="text-muted small"
                                         t-esc="tenant.company_name"/>
                                </div>
                                <span class="badge"
                                      t-att-class="stateClass(tenant)"
                                      t-esc="stateLabel(tenant)"/>
                            </div>

                            <div class="mt-2 small">
                                <a t-att-href="tenant.url" target="_blank"
                                   t-esc="tenant.url"/>
                            </div>

                            <div t-if="tenant.state === 'active' and tenant.admin_password"
                                 class="mt-3 p-2 bg-body-secondary rounded small">
                                <div><strong>Login:</strong> <span t-esc="tenant.admin_login"/></div>
                                <div>
                                    <strong>Password:</strong>
                                    <code t-esc="tenant.admin_password"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Hand this over once, then change it.
                                </div>
                            </div>

                            <div t-if="tenant.state === 'error'"
                                 class="mt-3 p-2 border border-danger rounded small text-danger">
                                <div class="fw-bold mb-1">Provisioning failed</div>
                                <div class="text-truncate" t-att-title="tenant.error_message"
                                     t-esc="tenant.error_message"/>
                            </div>
                        </div>

                        <div class="card-footer d-flex gap-2 bg-transparent">
                            <a t-if="tenant.state === 'active'"
                               class="btn btn-sm btn-secondary"
                               t-att-href="tenant.url" target="_blank">Open</a>
                            <button t-if="tenant.state === 'error'"
                                    class="btn btn-sm btn-secondary"
                                    t-on-click="() => this.onRetry(tenant)">Retry</button>
                            <button t-if="['active', 'error'].includes(tenant.state)"
                                    class="btn btn-sm btn-link text-danger ms-auto"
                                    t-on-click="() => this.onDrop(tenant)">Drop</button>
                        </div>
                    </div>
                </div>
            </div>

            <div t-if="hasPending" class="text-muted small mt-3">
                <i class="fa fa-circle-o-notch fa-spin me-1"/>
                Work in progress — this page refreshes itself.
            </div>
        </div>
    </t>

    <t t-name="msolutions_saas.NewTenantDialog">
        <Dialog title="'New Tenant'" size="'md'">
            <div class="mb-3">
                <label class="form-label" for="saas_tenant_name">Tenant name</label>
                <input id="saas_tenant_name" type="text" class="form-control"
                       placeholder="acme" autocomplete="off"
                       t-att-value="state.name" t-on-input="onNameInput"/>
                <div class="form-text">
                    Becomes the database name and the subdomain.
                    <span t-if="preview">→ <code t-esc="preview"/></span>
                </div>
                <div t-if="state.error" class="text-danger small mt-1"
                     t-esc="state.error"/>
            </div>
            <div class="mb-1">
                <label class="form-label" for="saas_company_name">Company (optional)</label>
                <input id="saas_company_name" type="text" class="form-control"
                       autocomplete="off" t-model="state.companyName"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm">Create</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
