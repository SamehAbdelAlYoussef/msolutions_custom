<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_process_tenants" model="ir.cron">
            <field name="name">SaaS: process pending tenants</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Rescues records stuck in provisioning/terminating (a worker that
             died mid-run). Separate from the processing cron so a hung run of
             one does not stop the other. -->
        <record id="cron_watchdog" model="ir.cron">
            <field name="name">SaaS: watchdog for stuck tenants</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
