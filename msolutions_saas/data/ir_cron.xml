<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_process_tenants" model="ir.cron">
            <field name="name">SaaS: process pending tenants</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Rescues records stuck in provisioning/terminating (a worker that
             died mid-run). Separate from the processing cron so a hung run of
             one does not stop the other. -->
        <record id="cron_watchdog" model="ir.cron">
            <field name="name">SaaS: watchdog for stuck tenants</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Catches tenants whose data grew past their quota and suspends them.
             Manual quota changes enforce immediately (write hook); this timer
             covers organic growth. -->
        <record id="cron_enforce_quota" model="ir.cron">
            <field name="name">SaaS: enforce storage quotas</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model._cron_enforce_quota()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Refreshes the read-only backup registry from the host-generated
             manifest. Read-only: never touches B2, never writes a backup. -->
        <record id="cron_sync_backups" model="ir.cron">
            <field name="name">SaaS: sync backup registry</field>
            <field name="model_id" ref="model_saas_backup"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_backups()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Reads the host tenant-health probe (tenant_health.json) and refreshes
             reachability_state + the orphan-DB list. Read-only consumer; the probe
             runs on the host and never touches a tenant database meaningfully. -->
        <record id="cron_sync_reachability" model="ir.cron">
            <field name="name">SaaS: sync tenant reachability</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_reachability()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Backup Now: dump the next queued job under the shared filestore lock,
             and finalize jobs the host uploader has reported. Triggered on demand
             by action_backup_now; the 1-min interval is a safety net. -->
        <record id="cron_process_backups" model="ir.cron">
            <field name="name">SaaS: process backup jobs</field>
            <field name="model_id" ref="model_saas_backup_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_tick()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Rescue backup jobs whose worker/host died mid-step: fail them and
             delete their staged dump (30-min default timeout). -->
        <record id="cron_backup_watchdog" model="ir.cron">
            <field name="name">SaaS: backup watchdog</field>
            <field name="model_id" ref="model_saas_backup_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Prepare backup-download links: fresh dump (container) or ask the host
             to restore an existing snapshot; then finalize + expire links. -->
        <record id="cron_prepare_downloads" model="ir.cron">
            <field name="name">SaaS: prepare backup downloads</field>
            <field name="model_id" ref="model_saas_backup_download"/>
            <field name="state">code</field>
            <field name="code">model._cron_prepare()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
