<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Single suite entry point that preserves the Enterprise app layout.

        Odoo builds the app switcher from ROOT menus and the top navbar from the
        *children* of the root menu. Odoo Enterprise ships one Accounting app
        root, `accountant.menu_accounting`, whose 7 children are the navbar tabs:

            Dashboard | Customers | Vendors | Accounting | Review | Reporting | Configuration

        So instead of hanging extra menus next to that root (which produced a
        navbar like "Accounting | Financial Reports | Fiscal Categories | ..."),
        we move those 7 tabs under our own root and retire the Enterprise root.
        Result: one app card, one app entry, and the exact Enterprise tab set,
        order and nesting.

        Only the menu hierarchy changes - actions, groups and the modules
        themselves are untouched.
    -->

    <menuitem id="menu_msolutions_accounting_root"
              name="msolutions Accounting"
              sequence="1"
              web_icon="msolutions_accounting,static/description/icon.png"/>

    <!-- Enterprise Accounting navbar tabs -> children of the msolutions root.
         Sequences are the Enterprise ones (1,2,3,4,7,20,35) so ordering matches. -->
    <record id="account.menu_board_journal_1" model="ir.ui.menu">
        <field name="parent_id" ref="menu_msolutions_accounting_root"/>
    </record>
    <record id="account.menu_finance_receivables" model="ir.ui.menu">
        <field name="parent_id" ref="menu_msolutions_accounting_root"/>
    </record>
    <record id="account.menu_finance_payables" model="ir.ui.menu">
        <field name="parent_id" ref="menu_msolutions_accounting_root"/>
    </record>
    <record id="account.menu_finance_entries" model="ir.ui.menu">
        <field name="parent_id" ref="menu_msolutions_accounting_root"/>
    </record>
    <record id="account.account_audit_menu" model="ir.ui.menu">
        <field name="parent_id" ref="menu_msolutions_accounting_root"/>
    </record>
    <record id="account.menu_finance_reports" model="ir.ui.menu">
        <field name="parent_id" ref="menu_msolutions_accounting_root"/>
    </record>
    <record id="account.menu_finance_configuration" model="ir.ui.menu">
        <field name="parent_id" ref="menu_msolutions_accounting_root"/>
    </record>

    <!-- Retire the Enterprise root: its tabs now live under the msolutions root,
         so leaving it active would show a second "Accounting" app entry. -->
    <record id="accountant.menu_accounting" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
