<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Client actions for every financial report, mirroring Odoo Enterprise
        `account_reports/data/account_report_actions.xml` (same xml-ids, same
        `path`, same `tag`). The ported modules and the Enterprise menuitems
        resolve these xml-ids by name, so the ids must match exactly; only the
        `report_id` targets point at our own report records.

        `path` must be unique across ir.actions.actions - these values are the
        Enterprise ones, so no collision.
    -->

    <record id="action_account_report_bs" model="ir.actions.client">
        <field name="name">Balance Sheet</field>
        <field name="tag">account_report</field>
        <field name="path">balance-sheet</field>
        <field name="context" eval="{'report_id': ref('account_reports.balance_sheet')}"/>
    </record>

    <record id="action_account_report_pl" model="ir.actions.client">
        <field name="name">Profit and Loss</field>
        <field name="tag">account_report</field>
        <field name="path">profit-and-loss</field>
        <field name="context" eval="{'report_id': ref('account_reports.profit_and_loss')}"/>
    </record>

