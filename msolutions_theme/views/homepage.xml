<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Landing page: three sections injected inside the standard,
         still-editable homepage structure (#wrap stays an oe_structure).
         ================================================================ -->
    <template id="ms_homepage" inherit_id="website.homepage" name="Manager Solutions — Home">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class">oe_structure oe_structure_solo ms-site</attribute>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="inside">

            <!-- ============ HERO ============ -->
            <section class="ms-hero" data-name="Hero">
                <div class="ms-hero-bg" aria-hidden="true">
                    <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" fill="none" stroke="#c9945e">
                        <g opacity="0.16" stroke-width="2" stroke-linecap="round">
                            <path class="ms-flow" d="M-20 560 C 240 520, 470 420, 1220 150"/>
                            <path class="ms-flow ms-flow-2" d="M-20 620 C 300 585, 560 470, 1220 250"/>
                            <path class="ms-flow ms-flow-3" d="M-20 500 C 210 470, 520 350, 1220 60"/>
                        </g>
                        <g stroke="none" fill="#c9945e">
                            <circle class="ms-spark" cx="200" cy="470" r="3.5"/>
                            <circle class="ms-spark ms-spark-2" cx="470" cy="420" r="3"/>
                            <circle class="ms-spark ms-spark-3" cx="780" cy="300" r="3.5"/>
                            <circle class="ms-spark ms-spark-4" cx="1020" cy="200" r="3"/>
                        </g>
                    </svg>
                </div>
                <div class="ms-wrap">
                    <div class="ms-hero-grid">
                        <div class="ms-hero-copy">
                            <span class="ms-eyebrow">مانجر سوليوشنز — حلول مالية وإدارية</span>
                            <h1>دقّة المحاسبة وخبرة الميدان،<br/><span class="ms-accent">في شريكٍ واحد.</span></h1>
                            <p class="ms-lead">نقدّم حلولًا متكاملة للمراجعة والإدارة المالية، مصمّمة لدعم نموّ الشركات الصغيرة والمتوسطة — مع خبرة عميقة في تطبيق وتشغيل نظام Odoo ERP.</p>
                            <div class="ms-hero-actions">
                                <a href="/#ms-cta" class="ms-btn ms-btn-primary">احجز استشارة</a>
                                <a href="/#ms-about" class="ms-btn ms-btn-ghost">تعرّف علينا</a>
                            </div>
                        </div>
                        <div class="ms-hero-art" aria-hidden="true">
                            <svg viewBox="0 0 108 98" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <!-- logo mark: growth "M" + ascending bars + arrow -->
                                <g fill="#b07a4e">
                                    <rect class="ms-mark-bar" x="38" y="60" width="9" height="26" rx="2"/>
                                    <rect class="ms-mark-bar" x="53" y="50" width="9" height="36" rx="2"/>
                                    <rect class="ms-mark-bar" x="68" y="40" width="9" height="46" rx="2"/>
                                </g>
                                <g stroke="#b07a4e" stroke-width="13" fill="none">
                                    <path data-draw="1" d="M16 86 V28"/>
                                    <path data-draw="1" d="M16 28 L45 74 L70 36 L93 15"/>
                                </g>
                                <path class="ms-mark-arrow" d="M78 12 L101 8 L97 33 Z" fill="#b07a4e"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============ ① من نحن ============ -->
            <section id="ms-about" class="ms-section" data-name="About">
                <div class="ms-wrap">
                    <div class="ms-about-grid">
                        <div class="ms-about-body ms-reveal">
                            <span class="ms-eyebrow">من نحن</span>
                            <h2 class="ms-title">خبرة تجمع بين المال والصناعة</h2>
                            <p>نمتلك خبرة قوية في تطبيق وتشغيل نظام Odoo ERP، ونساعد الشركات على التحوّل الرقمي وتنظيم عملياتها المالية والإدارية بكفاءة وسهولة.</p>
                            <p>فريقنا يمتلك خبرة طويلة في إدارة وتشغيل مصانع ومعارض الأثاث في مصر، وهو ما يجعلنا نفهم السوق عن قُرب، ونقدّم حلولًا عملية تناسب التحدّيات الحقيقية.</p>
                        </div>
                        <div class="ms-pillars ms-stagger">
                            <div class="ms-pillar">
                                <div class="ms-pillar-k"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 1.5 14.5 8 8 14.5 1.5 8Z"/></svg></div>
                                <h3>تحوّل رقمي منظّم</h3>
                                <p>ننقل عملياتك إلى نظام واحد واضح، بدل الملفات المتفرّقة.</p>
                            </div>
                            <div class="ms-pillar">
                                <div class="ms-pillar-k"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 1.5 14.5 8 8 14.5 1.5 8Z"/></svg></div>
                                <h3>خبرة من داخل الميدان</h3>
                                <p>من مصانع ومعارض الأثاث، لا من الورق فقط.</p>
                            </div>
                            <div class="ms-pillar">
                                <div class="ms-pillar-k"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 1.5 14.5 8 8 14.5 1.5 8Z"/></svg></div>
                                <h3>قرارات أدقّ</h3>
                                <p>بيانات مالية واضحة، في وقتها، تدعم كل قرار.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============ ② خدماتنا ============ -->
            <section id="ms-services" class="ms-section ms-services" data-name="Services">
                <div class="ms-focus" aria-hidden="true"><span></span><span></span></div>
                <div class="ms-wrap">
                    <span class="ms-eyebrow">خدماتنا</span>
                    <h2 class="ms-title">أربع خدمات تبني أساسًا ماليًا متينًا</h2>
                    <p class="ms-lead">من إدارة الحسابات اليومية إلى تشغيل نظام متكامل يدير نشاطك بالكامل.</p>
                    <div class="ms-services-grid ms-stagger">
                        <div class="ms-svc">
                            <div class="ms-svc-mark"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="6" width="24" height="16" rx="1.5"/><path d="M4 26h24M11 22v4m10-4v4M9 12h6m-6 4h10"/></svg></div>
                            <h3>المحاسبة عن بُعد</h3>
                            <p>إدارة حساباتك بالكامل عن بُعد، بفريق محترف وتقارير منتظمة تصلك في موعدها.</p>
                        </div>
                        <div class="ms-svc">
                            <div class="ms-svc-mark"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="14" r="8"/><path d="M20 20l6 6M11 14h6m-6-3h4m-4 6h5"/></svg></div>
                            <h3>المراجعة المالية</h3>
                            <p>مراجعة دقيقة لحساباتك تكشف الفجوات مبكرًا وتحمي مالك من المخاطر.</p>
                        </div>
                        <div class="ms-svc">
                            <div class="ms-svc-mark"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4v24M6 10l10-6 10 6M8 13v8m16-8v8"/><circle cx="16" cy="16" r="2.4"/></svg></div>
                            <h3>الاستشارات المالية والإدارية</h3>
                            <p>رؤية عملية لقراراتك المالية والتشغيلية، مبنية على أرقام لا تخمين.</p>
                        </div>
                        <div class="ms-svc">
                            <div class="ms-svc-mark"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="3"/><circle cx="24" cy="8" r="3"/><circle cx="16" cy="24" r="3"/><path d="M8 11v4a3 3 0 003 3h10a3 3 0 003-3v-4M16 18v3"/></svg></div>
                            <h3>تطبيق وتشغيل أنظمة ERP</h3>
                            <p>تطبيق وتشغيل Odoo خصيصًا لطبيعة نشاطك، حتى يعمل النظام كما تحتاجه تمامًا.</p>
                        </div>
                    </div>
                </div>
            </section>

