<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_refresh_running" model="ir.cron">
        <field name="name">AI Lead Gen: refresh running runs</field>
        <field name="model_id" ref="model_ai_leadgen_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_running()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_sync_target_groups" model="ir.cron">
        <field name="name">AI Lead Gen: sync target groups with the engine</field>
        <field name="model_id" ref="model_leadgen_source"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_engine()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_sync_ops" model="ir.cron">
        <field name="name">AI Lead Gen: synchronize the operations dashboard</field>
        <field name="model_id" ref="model_ai_leadgen_candidate"/>
        <field name="state">code</field>
        <field name="code">model._sync_from_engine()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <!-- Off by default: enable it to run the engine on a schedule, as the administrator user. -->
    <record id="ir_cron_scheduled_run" model="ir.cron">
        <field name="name">AI Lead Gen: scheduled run</field>
        <field name="model_id" ref="model_ai_leadgen_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_start_scheduled_run()</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
